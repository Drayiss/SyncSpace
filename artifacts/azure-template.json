{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "5725381021508692762"
    }
  },
  "parameters": {
    "image": {
      "type": "string",
      "metadata": {
        "description": "Container image containing both the API and React frontend."
      }
    },
    "registryName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional private ACR name created by registry.bicep. Leave empty for a public image."
      }
    },
    "imagePullIdentityName": {
      "type": "string",
      "defaultValue": "[format('{0}-image-pull', parameters('prefix'))]",
      "metadata": {
        "description": "User-assigned image pull identity created by registry.bicep."
      }
    },
    "existingEnvironmentResourceId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional existing Container Apps environment ID for subscriptions with a one-environment quota."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "prefix": {
      "type": "string",
      "defaultValue": "syncspace",
      "minLength": 3,
      "maxLength": 18
    },
    "postgresUser": {
      "type": "string",
      "defaultValue": "syncspaceadmin"
    },
    "postgresPassword": {
      "type": "securestring",
      "minLength": 16
    },
    "otlpEndpoint": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional OTLP collector URL. Leave empty when no collector is available."
      }
    },
    "minReplicas": {
      "type": "int",
      "defaultValue": 2,
      "minValue": 2
    },
    "maxReplicas": {
      "type": "int",
      "defaultValue": 4,
      "minValue": 2
    },
    "redisHighAvailability": {
      "type": "string",
      "defaultValue": "Enabled",
      "allowedValues": [
        "Enabled",
        "Disabled"
      ],
      "metadata": {
        "description": "Disable Redis HA to reduce demo costs. PostgreSQL reconciliation repairs missed broadcasts."
      }
    }
  },
  "variables": {
    "suffix": "[uniqueString(resourceGroup().id)]",
    "appName": "[format('{0}-app', parameters('prefix'))]",
    "tags": {
      "project": "SyncSpace"
    },
    "environmentId": "[if(empty(parameters('existingEnvironmentResourceId')), resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('prefix'))), extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', split(parameters('existingEnvironmentResourceId'), '/')[2], split(parameters('existingEnvironmentResourceId'), '/')[4]), 'Microsoft.App/managedEnvironments', last(split(parameters('existingEnvironmentResourceId'), '/'))))]"
  },
  "resources": [
    {
      "condition": "[empty(parameters('existingEnvironmentResourceId'))]",
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[format('{0}-logs-{1}', parameters('prefix'), variables('suffix'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "condition": "[empty(parameters('existingEnvironmentResourceId'))]",
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}-env', parameters('prefix'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "workloadProfiles": [
          {
            "name": "Consumption",
            "workloadProfileType": "Consumption"
          }
        ],
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs-{1}', parameters('prefix'), variables('suffix'))), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs-{1}', parameters('prefix'), variables('suffix'))), '2023-09-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs-{1}', parameters('prefix'), variables('suffix')))]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}-pg-{1}', parameters('prefix'), variables('suffix'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "Standard_B1ms",
        "tier": "Burstable"
      },
      "properties": {
        "administratorLogin": "[parameters('postgresUser')]",
        "administratorLoginPassword": "[parameters('postgresPassword')]",
        "version": "17",
        "storage": {
          "storageSizeGB": 32
        },
        "backup": {
          "backupRetentionDays": 7,
          "geoRedundantBackup": "Disabled"
        },
        "highAvailability": {
          "mode": "Disabled"
        },
        "network": {
          "publicNetworkAccess": "Enabled"
        }
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/databases",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}/{1}', format('{0}-pg-{1}', parameters('prefix'), variables('suffix')), 'syncspace')]",
      "properties": {
        "charset": "UTF8",
        "collation": "en_US.utf8"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-pg-{1}', parameters('prefix'), variables('suffix')))]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/firewallRules",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}/{1}', format('{0}-pg-{1}', parameters('prefix'), variables('suffix')), 'AllowAzureServices')]",
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-pg-{1}', parameters('prefix'), variables('suffix')))]"
      ]
    },
    {
      "type": "Microsoft.Cache/redisEnterprise",
      "apiVersion": "2025-07-01",
      "name": "[format('{0}-redis-{1}', parameters('prefix'), variables('suffix'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "Balanced_B0"
      },
      "properties": {
        "minimumTlsVersion": "1.2",
        "highAvailability": "[parameters('redisHighAvailability')]",
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.Cache/redisEnterprise/databases",
      "apiVersion": "2025-07-01",
      "name": "[format('{0}/{1}', format('{0}-redis-{1}', parameters('prefix'), variables('suffix')), 'default')]",
      "properties": {
        "clientProtocol": "Encrypted",
        "clusteringPolicy": "EnterpriseCluster",
        "evictionPolicy": "NoEviction",
        "port": 10000,
        "accessKeysAuthentication": "Enabled"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cache/redisEnterprise', format('{0}-redis-{1}', parameters('prefix'), variables('suffix')))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2025-01-01",
      "name": "[variables('appName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "identity": "[if(not(empty(parameters('registryName'))), createObject('type', 'UserAssigned', 'userAssignedIdentities', createObject(format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('imagePullIdentityName'))), createObject())), createObject('type', 'None'))]",
      "properties": {
        "managedEnvironmentId": "[variables('environmentId')]",
        "workloadProfileName": "Consumption",
        "configuration": {
          "activeRevisionsMode": "Single",
          "registries": "[if(not(empty(parameters('registryName'))), createArray(createObject('server', reference(resourceId('Microsoft.ContainerRegistry/registries', parameters('registryName')), '2023-07-01').loginServer, 'identity', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('imagePullIdentityName')))), createArray())]",
          "ingress": {
            "external": true,
            "targetPort": 8080,
            "transport": "auto",
            "allowInsecure": false
          },
          "secrets": [
            {
              "name": "postgres",
              "value": "[format('Host={0};Database=syncspace;Username={1};Password=\"{2}\";SSL Mode=VerifyFull', reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-pg-{1}', parameters('prefix'), variables('suffix'))), '2024-08-01').fullyQualifiedDomainName, parameters('postgresUser'), replace(parameters('postgresPassword'), '\"', '\"\"'))]"
            },
            {
              "name": "redis",
              "value": "[format('{0}:10000,password={1},ssl=true,abortConnect=false', reference(resourceId('Microsoft.Cache/redisEnterprise', format('{0}-redis-{1}', parameters('prefix'), variables('suffix'))), '2025-07-01').hostName, listKeys(resourceId('Microsoft.Cache/redisEnterprise/databases', format('{0}-redis-{1}', parameters('prefix'), variables('suffix')), 'default'), '2025-07-01').primaryKey)]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "syncspace",
              "image": "[parameters('image')]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "env": [
                {
                  "name": "ConnectionStrings__Postgres",
                  "secretRef": "postgres"
                },
                {
                  "name": "ConnectionStrings__Redis",
                  "secretRef": "redis"
                },
                {
                  "name": "AllowedOrigins",
                  "value": "[format('https://{0}.{1}', variables('appName'), if(empty(parameters('existingEnvironmentResourceId')), reference(resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('prefix'))), '2025-01-01').defaultDomain, reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', split(parameters('existingEnvironmentResourceId'), '/')[2], split(parameters('existingEnvironmentResourceId'), '/')[4]), 'Microsoft.App/managedEnvironments', last(split(parameters('existingEnvironmentResourceId'), '/'))), '2025-01-01').defaultDomain))]"
                },
                {
                  "name": "OTEL_EXPORTER_OTLP_ENDPOINT",
                  "value": "[parameters('otlpEndpoint')]"
                }
              ],
              "probes": [
                {
                  "type": "Startup",
                  "httpGet": {
                    "path": "/health/live",
                    "port": 8080
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 5,
                  "failureThreshold": 60
                },
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/health/live",
                    "port": 8080
                  },
                  "periodSeconds": 20
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/health/ready",
                    "port": 8080
                  },
                  "periodSeconds": 10
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": "[parameters('maxReplicas')]",
            "rules": [
              {
                "name": "http",
                "http": {
                  "metadata": {
                    "concurrentRequests": "100"
                  }
                }
              }
            ]
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers/databases', format('{0}-pg-{1}', parameters('prefix'), variables('suffix')), 'syncspace')]",
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('prefix')))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers/firewallRules', format('{0}-pg-{1}', parameters('prefix'), variables('suffix')), 'AllowAzureServices')]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-pg-{1}', parameters('prefix'), variables('suffix')))]",
        "[resourceId('Microsoft.Cache/redisEnterprise', format('{0}-redis-{1}', parameters('prefix'), variables('suffix')))]",
        "[resourceId('Microsoft.Cache/redisEnterprise/databases', format('{0}-redis-{1}', parameters('prefix'), variables('suffix')), 'default')]"
      ]
    }
  ],
  "outputs": {
    "url": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', variables('appName')), '2025-01-01').configuration.ingress.fqdn)]"
    },
    "appName": {
      "type": "string",
      "value": "[variables('appName')]"
    },
    "postgresHost": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-pg-{1}', parameters('prefix'), variables('suffix'))), '2024-08-01').fullyQualifiedDomainName]"
    }
  }
}